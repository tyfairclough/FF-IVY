# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Shared tablet password (single login for all carers)
APP_PASSWORD=change-me

# Random secret used to sign the session cookie (at least 32 characters)
SESSION_SECRET=replace-with-a-long-random-string

# Shared secret for optional Blynk → FF-IVY webhook fallback
MICROCLIMATE_WEBHOOK_SECRET=replace-with-a-long-random-string

# Blynk Device HTTPS API (primary Microclimate ingest via cron poll)
# Server host from bottom-right of Microclimate/Blynk console, with https:// and no trailing slash
BLYNK_SERVER_URL=https://blynk.cloud
# Device auth token from Device info (Ivy enclosure)
BLYNK_DEVICE_TOKEN=replace-with-device-auth-token
# Optional display name stored with readings
BLYNK_DEVICE_NAME=Ivy enclosure

# Vercel Cron Authorization: Bearer <CRON_SECRET> (required in production)
CRON_SECRET=replace-with-a-long-random-string

# OpenAI API key for natural-language voice intents
OPENAI_API_KEY=sk-...
