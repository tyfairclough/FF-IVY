# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Shared tablet password (single login for all carers)
APP_PASSWORD=change-me

# Random secret used to sign the session cookie (at least 32 characters)
SESSION_SECRET=replace-with-a-long-random-string

# Shared secret for Blynk → FF-IVY Microclimate webhooks (send as X-Webhook-Secret)
MICROCLIMATE_WEBHOOK_SECRET=replace-with-a-long-random-string

# OpenAI API key for natural-language voice intents
OPENAI_API_KEY=sk-...
